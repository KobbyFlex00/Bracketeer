# Copy to .env for local development. Never commit .env.
# Leave DATABASE_URL empty to use a local SQLite file (instance/bracketeer.db).
DATABASE_URL=
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
FLASK_APP=wsgi.py
# BRACKETEER_ENV=production   # set on the server: requires SECRET_KEY, enables secure cookies

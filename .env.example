# Copy to .env for local development. Never commit .env.
# Leave DATABASE_URL empty to use a local SQLite file (instance/bracketeer.db).
# With the Neon CLI linked, `neon env pull` writes both URLs to .env.local instead (loaded automatically).
# DATABASE_URL: pooled Neon URL (host contains -pooler), used by the app.
# DATABASE_URL_UNPOOLED: direct Neon URL, used only by `flask db upgrade` (Alembic).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
FLASK_APP=wsgi.py
# BRACKETEER_ENV=production   # set on the server: requires SECRET_KEY, enables secure cookies
